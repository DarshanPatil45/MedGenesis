# Copy this file to backend/.env and fill in real values there.
# backend/.env is gitignored and must NEVER be committed.
# This example file must only ever contain placeholders.

# --- Datastore -------------------------------------------------------------
# SQLite is the project's database. The file is created automatically on
# first run — there is nothing to install or start. You only need this line
# if you want the database somewhere other than backend/medgenesis.db.
# DATABASE_URL=sqlite:///./medgenesis.db


# --- Conversational Assistant Agent ----------------------------------------
# The chat agent tries three backends in order and uses the first available:
#   1. Mistral API   (hosted, needs MISTRAL_API_KEY — NOT free/open-source)
#   2. Ollama        (local, free, open-source, no key)
#   3. Rule-based    (always works, no dependencies)
# Every other part of MedGenesis runs fully offline regardless of this setting.

# Hosted Mistral API. Leave BLANK to skip it and use local Ollama instead.
# Get a key at https://console.mistral.ai — paste it into backend/.env, never here.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Local Ollama server (free/open-source; used when no Mistral key is set).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Set to "true" to force the deterministic rule-based responder and skip all
# network LLM calls — useful for reproducible grading runs.
MEDGENESIS_DISABLE_LLM=false


# --- Medical Evidence Agent: PubMed (PLANNED, not yet implemented) ---------
# See app/services/pubmed.py — scaffolding only right now, no live calls are
# made regardless of these being set. NCBI's E-utilities usage policy asks
# for an identifying email with every request; an API key is optional but
# raises the request-rate limit.
PUBMED_API_KEY=
PUBMED_EMAIL=
